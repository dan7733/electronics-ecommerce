<!-- views/resetPassword.ejs -->
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đặt lại mật khẩu</title>
  <!-- Bootstrap 5 & FontAwesome -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    :root {
      --primary-teal: #218282;
      --hover-teal: #1a6565;
      --light-teal: #e6fffa;
      --border-teal: #b2f5ea;
      --bg-body: #f8fafc;
      --text-main: #1e293b;
      --text-muted: #64748b;
    }

    body {
      background-color: var(--bg-body);
      color: var(--text-main);
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 20px 15px;
    }

    .reset-card {
      max-width: 440px;
      width: 100%;
      background-color: #ffffff;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      padding: 36px 28px;
    }

    .icon-wrapper {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin-bottom: 20px;
    }

    .icon-wrapper.default {
      background-color: var(--light-teal);
      color: var(--primary-teal);
      border: 1px solid var(--border-teal);
    }

    .icon-wrapper.error {
      background-color: #fef2f2;
      color: #ef4444;
      border: 1px solid #fee2e2;
    }

    .icon-wrapper.success {
      background-color: var(--light-teal);
      color: var(--primary-teal);
      border: 1px solid var(--border-teal);
    }

    .card-title {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--primary-teal);
      margin-bottom: 8px;
    }

    .card-subtitle {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 24px;
      line-height: 1.5;
    }

    /* Input Group tích hợp Icon & Eye Toggle */
    .input-wrapper {
      position: relative;
      margin-bottom: 16px;
    }

    .input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 0.95rem;
      transition: color 0.2s ease;
      z-index: 5;
    }

    .toggle-eye {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #94a3b8;
      font-size: 0.95rem;
      cursor: pointer;
      z-index: 5;
      padding: 4px;
      transition: color 0.2s ease;
    }

    .toggle-eye:hover {
      color: var(--primary-teal);
    }

    .form-control-custom {
      width: 100%;
      padding: 12px 42px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      font-size: 0.9rem;
      outline: none;
      background-color: #ffffff;
      transition: all 0.2s ease;
    }

    .form-control-custom:focus {
      border-color: var(--primary-teal);
      box-shadow: 0 0 0 3.5px rgba(33, 130, 130, 0.12);
    }

    .input-wrapper:focus-within .input-icon {
      color: var(--primary-teal);
    }

    /* Button Teal Sync */
    .btn-teal {
      background-color: var(--primary-teal);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 12px;
      font-size: 0.92rem;
      font-weight: 700;
      width: 100%;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      display: inline-block;
    }

    .btn-teal:hover {
      background-color: var(--hover-teal);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(33, 130, 130, 0.25);
      transform: translateY(-1px);
    }

    /* Message Callouts */
    .alert-custom-error {
      background-color: #fef2f2;
      border: 1px solid #fee2e2;
      color: #dc2626;
      border-radius: 10px;
      padding: 14px;
      font-size: 0.9rem;
      margin-bottom: 16px;
    }

    .alert-custom-success {
      background-color: var(--light-teal);
      border: 1px solid var(--border-teal);
      color: var(--primary-teal);
      border-radius: 10px;
      padding: 14px;
      font-size: 0.9rem;
      margin-bottom: 16px;
    }

    .validation-error {
      color: #ef4444;
      font-size: 0.82rem;
      text-align: left;
      margin-top: -10px;
      margin-bottom: 14px;
      display: none;
    }
  </style>
</head>
<body>

  <div class="reset-card text-center">
    <% if (errorMessage) { %>
      <!-- TRẠNG THÁI LỖI -->
      <div class="icon-wrapper error">
        <i class="fas fa-exclamation-triangle"></i>
      </div>
      <h3 class="card-title text-danger mb-2">Đã xảy ra lỗi</h3>
      <div class="alert-custom-error">
        <%= errorMessage %>
      </div>
      <p class="card-subtitle">Liên kết đặt lại mật khẩu có thể đã hết hạn hoặc không hợp lệ.</p>
      <a href="http://localhost:3001/forgot-password" class="btn btn-teal">
        <i class="fas fa-redo me-2"></i>Thử lại
      </a>

    <% } else if (successMessage) { %>
      <!-- TRẠNG THÁI THÀNH CÔNG -->
      <div class="icon-wrapper success">
        <i class="fas fa-check-circle"></i>
      </div>
      <h3 class="card-title mb-2">Thành công!</h3>
      <div class="alert-custom-success">
        <%= successMessage %>
      </div>
      <p class="card-subtitle">Mật khẩu của bạn đã được cập nhật thành công. Vui lòng đăng nhập lại.</p>
      <a href="http://localhost:3001/login" class="btn btn-teal">
        <i class="fas fa-sign-in-alt me-2"></i>Quay lại đăng nhập
      </a>

    <% } else { %>
      <!-- FORM NHẬP MẬT KHẨU MỚI -->
      <div class="icon-wrapper default">
        <i class="fas fa-lock"></i>
      </div>
      <h3 class="card-title">ĐẶT LẠI MẬT KHẨU</h3>
      <p class="card-subtitle">Nhập mật khẩu mới của bạn bên dưới để hoàn tất việc khôi phục tài khoản.</p>

      <form action="/api/v1/reset-password" method="POST" id="resetPasswordForm">
        <input type="hidden" name="token" value="<%= token %>">
        
        <!-- Mật khẩu mới -->
        <div class="input-wrapper">
          <i class="fas fa-key input-icon"></i>
          <input
            type="password"
            id="newPassword"
            class="form-control-custom"
            name="newPassword"
            placeholder="Mật khẩu mới (ít nhất 6 ký tự)"
            required
            minLength="6"
          />
          <i class="fas fa-eye toggle-eye" onclick="togglePasswordVisibility('newPassword', this)"></i>
        </div>

        <!-- Xác nhận mật khẩu mới -->
        <div class="input-wrapper">
          <i class="fas fa-shield-alt input-icon"></i>
          <input
            type="password"
            id="confirmPassword"
            class="form-control-custom"
            name="confirmPassword"
            placeholder="Xác nhận mật khẩu mới"
            required
          />
          <i class="fas fa-eye toggle-eye" onclick="togglePasswordVisibility('confirmPassword', this)"></i>
        </div>

        <!-- Thông báo lỗi lệch mật khẩu -->
        <div id="matchError" class="validation-error">
          <i class="fas fa-exclamation-circle me-1"></i> Mật khẩu xác nhận không trùng khớp.
        </div>

        <button type="submit" class="btn btn-teal mt-2">
          <i class="fas fa-save me-2"></i>Cập nhật mật khẩu
        </button>
      </form>
    <% } %>
  </div>

  <script>
    // Ẩn/Hiện mật khẩu
    function togglePasswordVisibility(inputId, eyeIcon) {
      const input = document.getElementById(inputId);
      if (input.type === 'password') {
        input.type = 'text';
        eyeIcon.classList.remove('fa-eye');
        eyeIcon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        eyeIcon.classList.remove('fa-eye-slash');
        eyeIcon.classList.add('fa-eye');
      }
    }

    // Kiểm tra khớp mật khẩu client-side
    const form = document.getElementById('resetPasswordForm');
    if (form) {
      form.addEventListener('submit', function (e) {
        const pass = document.getElementById('newPassword').value;
        const confirmPass = document.getElementById('confirmPassword').value;
        const errorDiv = document.getElementById('matchError');

        if (pass !== confirmPass) {
          e.preventDefault();
          errorDiv.style.display = 'block';
        } else {
          errorDiv.style.display = 'none';
        }
      });
    }
  </script>
</body>
</html>