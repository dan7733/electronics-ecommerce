<div class="container listdetails-container my-4">
    <% if (data.message) { %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <%= data.message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    
    <h4 class="mb-3 listdetails-title">Danh sách Chi Tiết Sản Phẩm</h4>

    <div class="d-flex justify-content-between mb-3 listdetails-container gap-2">
        <input type="text" id="details_searchInput" class="form-control w-50 listdetails-searchinput"
            placeholder="🔍 Tìm kiếm theo tên sản phẩm..." value="<%= data.search || '' %>">

        <!-- Lọc theo thương hiệu -->
        <div class="dropdown listdetails-filter-container">
            <button class="btn btn-secondary dropdown-toggle listdetails-filter" type="button" id="brandDropdown"
                data-bs-toggle="dropdown">
                <i class="fa-solid fa-tag"></i> <%= data.selectedBrand ? 'Thương hiệu (Đã chọn)' : 'Thương hiệu' %>
            </button>
            <ul class="dropdown-menu listdetails-option">
                <li><a class="dropdown-item" href="?page=1&search=<%= data.search || '' %>&category=<%= data.selectedCategory || '' %>&sort=<%= data.sort || '' %>&brand=">Tất cả</a></li>
                <% if (data.brands && data.brands.length > 0) { %>
                    <% data.brands.forEach((brand) => { %>
                        <li>
                            <a class="dropdown-item <%= String(data.selectedBrand) === String(brand.brand_id) ? 'active' : '' %>" 
                               href="?page=1&search=<%= data.search || '' %>&brand=<%= brand.brand_id %>&category=<%= data.selectedCategory || '' %>&sort=<%= data.sort || '' %>">
                                <%= brand.name %>
                            </a>
                        </li>
                    <% }) %>
                <% } %>
            </ul>
        </div>

        <!-- Lọc theo danh mục -->
        <div class="dropdown listdetails-filter-container">
            <button class="btn btn-secondary dropdown-toggle listdetails-filter" type="button" id="categoryDropdown"
                data-bs-toggle="dropdown">
                <i class="fa-solid fa-list"></i> <%= data.selectedCategory ? 'Danh mục (Đã chọn)' : 'Danh mục' %>
            </button>
            <ul class="dropdown-menu listdetails-option">
                <li><a class="dropdown-item" href="?page=1&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&sort=<%= data.sort || '' %>&category=">Tất cả</a></li>
                <% if (data.categories && data.categories.length > 0) { %>
                    <% data.categories.forEach((category) => { %>
                        <li>
                            <a class="dropdown-item <%= String(data.selectedCategory) === String(category.category_id) ? 'active' : '' %>" 
                               href="?page=1&search=<%= data.search || '' %>&category=<%= category.category_id %>&brand=<%= data.selectedBrand || '' %>&sort=<%= data.sort || '' %>">
                                <%= category.name %>
                            </a>
                        </li>
                    <% }) %>
                <% } %>
            </ul>
        </div>

        <!-- Bộ lọc sắp xếp -->
        <div class="dropdown listdetails-filter-container">
            <button class="btn btn-secondary dropdown-toggle listdetails-filter" type="button" id="filterDropdown"
                data-bs-toggle="dropdown">
                <i class="fa-solid fa-filter"></i> Lọc
            </button>
            <ul class="dropdown-menu listdetails-option">
                <li><a class="dropdown-item" href="?page=1&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&category=<%= data.selectedCategory || '' %>">Reset Sắp Xếp</a></li>
                <li><a class="dropdown-item" href="?page=1&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&category=<%= data.selectedCategory || '' %>&sort=price_asc">Giá tăng dần</a></li>
                <li><a class="dropdown-item" href="?page=1&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&category=<%= data.selectedCategory || '' %>&sort=price_desc">Giá giảm dần</a></li>
            </ul>
        </div>
    </div>

    <div class="table-responsive rounded p-2">
        <table class="table table-bordered listdetails-table align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 5%;">STT</th>
                    <th style="width: 45%;">Tên sản phẩm</th>
                    <th style="width: 20%;">Danh mục</th>
                    <th style="width: 15%;">Hãng sản xuất</th>
                    <th style="width: 15%;" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <% if (data.rows && data.rows.length > 0) { %>
                    <% data.rows.forEach((product, index) => { %>
                    <tr>
                        <td><%= (data.currentPage - 1) * 5 + index + 1 %></td>
                        <td class="fw-bold"><%= product.name %></td>
                        <td>
                            <span class="badge bg-info text-dark">
                                <%= product.Category ? product.Category.name : 'Chưa phân loại' %>
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-secondary">
                                <%= product.Brand ? product.Brand.name : 'Chưa có hãng' %>
                            </span>
                        </td>
                        <td class="text-center">
                            <a href="/editproductdetail/<%= product.product_id %>" class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil-square"></i> Cập nhật chi tiết
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="5" class="text-center py-4 text-muted">Không tìm thấy sản phẩm nào phù hợp với bộ lọc.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Phân trang duy trì URL query đầy đủ -->
    <% if (data.totalPages > 1) { %>
    <nav class="mt-3">
        <ul class="pagination justify-content-center listdetails-pagination">
            <li class="page-item <%= data.currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= data.currentPage - 1 %>&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&category=<%= data.selectedCategory || '' %>&sort=<%= data.sort || '' %>">«</a>
            </li>
            
            <li class="page-item <%= data.currentPage === 1 ? 'active' : '' %>">
                <a class="page-link" href="?page=1&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&category=<%= data.selectedCategory || '' %>&sort=<%= data.sort || '' %>">1</a>
            </li>
            
            <% if (data.currentPage > 4) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
            <% } %>
            
            <% for (let i = Math.max(2, data.currentPage - 2); i <= Math.min(data.totalPages - 1, data.currentPage + 2); i++) { %>
                <li class="page-item <%= data.currentPage === i ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&category=<%= data.selectedCategory || '' %>&sort=<%= data.sort || '' %>"><%= i %></a>
                </li>
            <% } %>
            
            <% if (data.currentPage < data.totalPages - 3) { %>
                <li class="page-item disabled"><span class="page-link">...</span></li>
            <% } %>
            
            <% if (data.totalPages > 1) { %>
                <li class="page-item <%= data.currentPage === data.totalPages ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= data.totalPages %>&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&category=<%= data.selectedCategory || '' %>&sort=<%= data.sort || '' %>"><%= data.totalPages %></a>
                </li>
            <% } %>
            
            <li class="page-item <%= data.currentPage === data.totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= data.currentPage + 1 %>&search=<%= data.search || '' %>&brand=<%= data.selectedBrand || '' %>&category=<%= data.selectedCategory || '' %>&sort=<%= data.sort || '' %>">»</a>
            </li>
        </ul>
    </nav>
    <% } %>
</div>

<script>
document.getElementById('details_searchInput').addEventListener('keypress', function (e) {
    if (e.key === 'Enter') {
        const keyword = e.target.value;
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('search', keyword);
        urlParams.set('page', 1);
        window.location.href = `?${urlParams.toString()}`;
    }
});
</script>