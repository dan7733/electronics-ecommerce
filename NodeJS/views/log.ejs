<!-- Nhúng file CSS (chỉnh sửa đường dẫn href theo cấu trúc thư mục public của bạn) -->
<link rel="stylesheet" href="/css/log.css">

<!-- ========================================= -->
<!-- HTML GIAO DIỆN CHÍNH                      -->
<!-- ========================================= -->
<div class="container mt-4">
    <div class="log-container card p-4 shadow-sm border-0">
        <h4 class="mb-4 text-primary fw-bold" style="color: #218282 !important;">
            <i class="fas fa-server"></i> Xem Log Hệ Thống
        </h4>

        <% if (typeof data !== 'undefined' && data.message) { %>
            <div class="alert alert-info"><%= data.message %></div>
        <% } %>

        <!-- Filter Log Type -->
        <div class="mb-4">
            <label class="form-label fw-bold">Lọc theo loại log</label>
            <div class="btn-group d-block" role="group">
                <button id="btn-type-all" onclick="filterLogType('all')" class="btn btn-primary log-filter-btn active">Tất cả</button>
                <button id="btn-type-error" onclick="filterLogType('error')" class="btn btn-outline-primary log-filter-btn">Error</button>
                <button id="btn-type-application" onclick="filterLogType('application')" class="btn btn-outline-primary log-filter-btn">Application</button>
            </div>
        </div>

        <!-- Chọn ngày -->
        <div class="mb-4">
            <label class="form-label fw-bold">Chọn ngày log</label>
            <div class="input-group" style="max-width: 350px;">
                <input type="date" id="logDate" class="form-control" value="<%= (typeof data !== 'undefined' && data.selectedDate) ? data.selectedDate : '' %>" onchange="changeDate(this.value)">
                <button class="btn btn-outline-secondary" type="button" onclick="clearDate()" title="Xóa bộ lọc ngày">
                    <i class="fas fa-times"></i> Đặt lại
                </button>
            </div>
        </div>

        <!-- Danh sách file log (Gom nhóm theo ngày) -->
        <div class="mb-4">
            <label class="form-label fw-bold">Danh sách tệp</label>
            <div id="logFilesContainer" class="p-3 bg-light rounded border">
                <div class="text-center text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...</div>
            </div>
        </div>

        <!-- Bộ lọc thời gian -->
        <div class="mb-4" id="timeFilter" style="display: none;">
            <label class="form-label fw-bold">Lọc theo khoảng thời gian</label>
            <div class="d-flex gap-2 align-items-center" style="max-width: 450px;">
                <input type="time" id="startTime" class="form-control" onchange="applyFilters()">
                <span class="fw-bold">—</span>
                <input type="time" id="endTime" class="form-control" onchange="applyFilters()">
                <button class="btn btn-outline-secondary text-nowrap" type="button" onclick="clearTime()">
                    <i class="fas fa-undo"></i> Đặt lại
                </button>
            </div>
        </div>

        <!-- Tìm kiếm -->
        <div class="mb-4" id="searchFilter" style="display: none;">
            <label class="form-label fw-bold">Tìm kiếm trong log</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                <input type="text" id="searchInput" class="form-control" placeholder="Nhập từ khóa (VD: ERROR, Upload, Token...)" onkeyup="applyFilters()">
            </div>
        </div>

        <!-- Nội dung log -->
        <div class="log-content mt-2" id="logContent" style="max-height: 600px; overflow-y: auto; display: none;">
            <!-- JS render log lines vào đây -->
        </div>
    </div>
</div>

<!-- ========================================= -->
<!-- JAVASCRIPT XỬ LÝ LOGIC LOG                -->
<!-- ========================================= -->
<script>
    // State quản lý
    let allFiles = [];
    let currentLogContent = [];
    
    let logType = 'all'; // 'all', 'error', 'application'
    let selectedDate = document.getElementById('logDate').value;
    let selectedFile = '';

    // Hàm gọi API lấy danh sách file
    async function loadLogFiles() {
        try {
            const res = await fetch('/api/v1/logs/files');
            const data = await res.json();
            
            if(data.errCode === 0) {
                allFiles = data.data || [];
                renderLogFiles();
            } else {
                document.getElementById('logFilesContainer').innerHTML = `<p class="text-danger">Lỗi: ${data.message}</p>`;
            }
        } catch (error) {
            document.getElementById('logFilesContainer').innerHTML = `<p class="text-danger">Không thể tải file log. Vui lòng kiểm tra lại server.</p>`;
        }
    }

    // Gom nhóm file theo ngày
    function groupFilesByDate() {
        const grouped = {};
        
        allFiles.filter(file => {
            if (logType !== 'all' && !file.startsWith(`${logType}-`)) return false;
            if (selectedDate && !file.includes(selectedDate)) return false;
            return true;
        }).forEach(file => {
            const dateMatch = file.match(/\d{4}-\d{2}-\d{2}/);
            if (dateMatch) {
                const date = dateMatch[0];
                if (!grouped[date]) grouped[date] = { error: null, application: null };
                if (file.startsWith('error-')) grouped[date].error = file;
                else if (file.startsWith('application-')) grouped[date].application = file;
            }
        });

        // Sắp xếp ngày mới nhất lên trên
        return Object.entries(grouped).sort((a, b) => b[0].localeCompare(a[0])); 
    }

    // Định dạng lại ngày để hiển thị
    function formatDate(dateStr) {
        const [year, month, day] = dateStr.split('-');
        return `${day}/${month}/${year}`;
    }

    // Hiển thị danh sách file
    function renderLogFiles() {
        const container = document.getElementById('logFilesContainer');
        const groups = groupFilesByDate();

        if (groups.length === 0) {
            container.innerHTML = '<p class="text-muted mb-0">Không có log nào phù hợp với bộ lọc hiện tại.</p>';
            return;
        }

        let html = '<div class="row g-3">';
        groups.forEach(([date, logs]) => {
            html += `
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 bg-white">
                    <div class="card-body p-3">
                        <h6 class="mb-3 fw-bold border-bottom pb-2 text-dark">${formatDate(date)}</h6>
                        <div class="d-flex gap-2">
                            ${logs.error ? `
                                <button class="btn btn-sm flex-fill ${selectedFile === logs.error ? 'btn-danger' : 'btn-outline-danger'}" 
                                        onclick="loadLogContent('${logs.error}')">Error</button>` : ''}
                            ${logs.application ? `
                                <button class="btn btn-sm flex-fill ${selectedFile === logs.application ? 'btn-success' : 'btn-outline-success'}" 
                                        onclick="loadLogContent('${logs.application}')">Application</button>` : ''}
                        </div>
                    </div>
                </div>
            </div>`;
        });
        html += '</div>';
        
        container.innerHTML = html;
    }

    // Chọn thay đổi loại log (Tất cả, Error, Application)
    function filterLogType(type) {
        logType = type;
        
        // Cập nhật giao diện nút bấm
        document.querySelectorAll('.log-filter-btn').forEach(btn => {
            btn.classList.remove('btn-primary', 'active');
            btn.classList.add('btn-outline-primary');
        });
        document.getElementById(`btn-type-${type}`).classList.remove('btn-outline-primary');
        document.getElementById(`btn-type-${type}`).classList.add('btn-primary', 'active');

        resetLogView();
        renderLogFiles();
    }

    // Chọn thay đổi ngày
    function changeDate(date) {
        selectedDate = date;
        resetLogView();
        renderLogFiles();
    }

    // Xóa bộ lọc ngày
    function clearDate() {
        document.getElementById('logDate').value = '';
        selectedDate = '';
        resetLogView();
        renderLogFiles();
    }

    // Xóa bộ lọc giờ
    function clearTime() {
        document.getElementById('startTime').value = '';
        document.getElementById('endTime').value = '';
        applyFilters(); 
    }

    // Gọi API lấy nội dung file
    async function loadLogContent(filename) {
        selectedFile = filename;
        renderLogFiles(); // Re-render cập nhật màu nút đang chọn

        // Reset các input text/thời gian
        document.getElementById('searchInput').value = '';
        document.getElementById('startTime').value = '';
        document.getElementById('endTime').value = '';

        const container = document.getElementById('logContent');
        container.style.display = 'block';
        container.innerHTML = '<div class="text-center text-white"><i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...</div>';
        
        document.getElementById('timeFilter').style.display = 'flex';
        document.getElementById('searchFilter').style.display = 'block';

        try {
            const res = await fetch(`/api/v1/logs/${filename}`);
            const data = await res.json();
            
            if(data.errCode === 0) {
                currentLogContent = data.data || [];
                applyFilters(); // Hiển thị nội dung
            } else {
                container.innerHTML = `<span class="text-danger">Lỗi: ${data.message}</span>`;
            }
        } catch (error) {
            container.innerHTML = `<span class="text-danger">Lỗi khi tải nội dung log.</span>`;
        }
    }

    // Chuyển giờ HH:MM thành số giây
    function timeToSeconds(timeStr) {
        const parts = timeStr.split(':');
        const h = parseInt(parts[0] || 0, 10);
        const m = parseInt(parts[1] || 0, 10);
        const s = parseInt(parts[2] || 0, 10);
        return h * 3600 + m * 60 + s;
    }

    // Lọc nội dung log (Theo text và theo giờ)
    function applyFilters() {
        const query = document.getElementById('searchInput').value.toLowerCase().trim();
        const start = document.getElementById('startTime').value;
        const end = document.getElementById('endTime').value;

        let filtered = currentLogContent;

        // Lọc khung giờ
        if (start || end) {
            filtered = filtered.filter(line => {
                const timeMatch = line.match(/^\d{4}-\d{2}-\d{2} (\d{2}:\d{2}:\d{2})/);
                if (!timeMatch) return false;
                
                const logTimeSec = timeToSeconds(timeMatch[1]);
                const startSec = start ? timeToSeconds(start + ':00') : 0;
                const endSec = end ? timeToSeconds(end + ':59') : 86400;

                return logTimeSec >= startSec && logTimeSec <= endSec;
            });
        }

        // Lọc từ khóa
        if (query) {
            filtered = filtered.filter(line => line.toLowerCase().includes(query));
        }

        const container = document.getElementById('logContent');
        if (filtered.length > 0) {
            container.innerHTML = filtered.map(line => {
                // Xác định màu sắc dòng log
                let cssClass = 'log-default';
                if(line.match(/error/i)) cssClass = 'log-error';
                else if(line.match(/warn/i)) cssClass = 'log-warn';
                else if(line.match(/info/i)) cssClass = 'log-info';
                
                // Highlight Timestamp
                let formattedLine = line.replace(/^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})/, '<span class="log-timestamp">[$1]</span>');
                
                return `<div class="log-line ${cssClass}">${formattedLine}</div>`;
            }).join('');
        } else {
            container.innerHTML = '<div class="text-muted p-3">Không tìm thấy kết quả phù hợp.</div>';
        }
    }

    // Ẩn vùng nội dung log
    function resetLogView() {
        selectedFile = '';
        currentLogContent = [];
        document.getElementById('timeFilter').style.display = 'none';
        document.getElementById('searchFilter').style.display = 'none';
        document.getElementById('logContent').style.display = 'none';
    }

    // Load file khi mở trang
    window.onload = () => {
        loadLogFiles();
    };
</script>